:root {
    --nabz-ink: #12100e;
    --nabz-cloth: #efe6d8;
    --nabz-copper: #ae4e2a;
    --nabz-muted: #716a62;
    --nabz-serif: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
    --nabz-sans: Inter, Helvetica, Arial, sans-serif;
  }

  html.nabz-home-active,
  html.nabz-home-active body {
    background: var(--nabz-ink);
  }

  html.nabz-home-active #header-group,
  html.nabz-home-active #footer-group,
  body:has(.nabz-landing) #header-group,
  body:has(.nabz-landing) #footer-group {
    display: none !important;
  }

  .nabz-landing,
  .nabz-landing * {
    box-sizing: border-box;
  }

  .nabz-landing {
    overflow: clip;
    color: var(--nabz-ink);
    background: var(--nabz-cloth);
    font-family: var(--nabz-sans);
  }

  .nabz-landing img {
    display: block;
    max-width: 100%;
  }

  .nabz-landing a,
  .nabz-landing button,
  .nabz-landing input {
    font: inherit;
  }

  .nabz-landing a:focus-visible,
  .nabz-landing button:focus-visible,
  .nabz-landing input:focus-visible,
  .nabz-surface-stage:focus-visible {
    outline: 2px solid var(--nabz-copper);
    outline-offset: 4px;
  }

  .nabz-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--nabz-ink) url({{ 'nabz-ink-textile-2048.webp' | asset_url }}) center / cover no-repeat;
    transition: opacity 280ms ease, visibility 280ms ease;
  }

  .nabz-loader.is-complete {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .nabz-loader__mark {
    position: relative;
    width: min(330px, 62vw);
    padding: 2rem 0;
    overflow: hidden;
  }

  .nabz-loader__mark img {
    width: 100%;
    height: auto;
  }

  .nabz-loader__thread {
    position: absolute;
    left: -12%;
    top: 57%;
    width: 18%;
    height: 1px;
    background: var(--nabz-copper);
    box-shadow: 0 0 10px rgba(174, 78, 42, .65);
    animation: nabz-loader-thread 900ms cubic-bezier(.65, 0, .2, 1) 140ms both;
  }

  .nabz-loader__thread::after {
    content: "";
    position: absolute;
    right: -3px;
    top: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--nabz-copper);
  }

  .nabz-loader__seam {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 1px;
    background: var(--nabz-copper);
    transform: scaleY(0);
    transform-origin: center;
    animation: nabz-loader-seam 430ms ease 820ms both;
  }

  @keyframes nabz-loader-thread {
    to { left: 94%; }
  }

  @keyframes nabz-loader-seam {
    60% { transform: scaleY(1); }
    100% { transform: scaleY(1) scaleX(38); opacity: 0; }
  }

  .nabz-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    padding: 14px clamp(18px, 4vw, 64px);
    color: var(--nabz-cloth);
    transition: background 300ms ease, min-height 300ms ease, box-shadow 300ms ease;
  }

  .nabz-header.is-solid {
    min-height: 64px;
    background: rgba(18, 16, 14, .92) url({{ 'nabz-ink-textile-2048.webp' | asset_url }}) center / cover;
    box-shadow: 0 1px 0 rgba(239, 230, 216, .1);
    backdrop-filter: blur(14px);
  }

  .nabz-header__brand {
    width: clamp(105px, 10vw, 148px);
    line-height: 0;
  }

  .nabz-header__brand img {
    width: 100%;
    height: auto;
  }

  .nabz-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
  }

  .nabz-header__nav a {
    position: relative;
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: 11px;
    font-weight: 650;
  }

  .nabz-header__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--nabz-copper);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms ease;
  }

  .nabz-header__nav a:hover::after,
  .nabz-header__nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .nabz-kicker {
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: .24em;
    font-size: 11px;
    font-weight: 700;
  }

  .nabz-hero {
    position: relative;
    height: 180vh;
    min-height: 1000px;
    color: var(--nabz-cloth);
    background: var(--nabz-ink);
    --hero-clip: 100%;
    --hero-copy-opacity: 1;
  }

  .nabz-hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 650px;
    overflow: hidden;
  }

  .nabz-hero__picture,
  .nabz-hero__macro,
  .nabz-hero__shade {
    position: absolute;
    inset: 0;
  }

  .nabz-hero__picture img,
  .nabz-hero__macro img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nabz-hero__picture img {
    object-position: center 26%;
  }

  .nabz-hero__macro {
    z-index: 2;
    clip-path: inset(0 var(--hero-clip) 0 0);
    will-change: clip-path;
  }

  .nabz-hero__macro img {
    object-position: center;
    transform: scale(1.04);
  }

  .nabz-hero__thread {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: calc(100% - var(--hero-clip));
    width: 1px;
    background: linear-gradient(transparent, var(--nabz-copper) 16%, var(--nabz-copper) 84%, transparent);
    box-shadow: 0 0 18px rgba(174, 78, 42, .4);
    transform: translateX(-1px);
    will-change: left;
  }

  .nabz-hero__shade {
    z-index: 4;
    background: linear-gradient(90deg, rgba(18, 16, 14, .82) 0%, rgba(18, 16, 14, .36) 43%, rgba(18, 16, 14, .06) 78%), linear-gradient(0deg, rgba(18, 16, 14, .45), transparent 38%);
    pointer-events: none;
  }

  .nabz-hero__copy {
    position: absolute;
    z-index: 5;
    left: clamp(22px, 7vw, 110px);
    top: 50%;
    width: min(650px, 52vw);
    transform: translateY(-46%);
    opacity: var(--hero-copy-opacity);
    will-change: opacity, transform;
  }

  .nabz-hero h1,
  .nabz-section-intro h2,
  .nabz-fit__intro h2,
  .nabz-crescendo h2,
  .nabz-gateway h2 {
    margin: 0;
    font-family: var(--nabz-serif);
    font-weight: 400;
    letter-spacing: -.035em;
  }

  .nabz-hero h1 {
    max-width: 640px;
    font-size: clamp(48px, 6.3vw, 104px);
    line-height: .94;
  }

  .nabz-hero h1 em {
    color: #d9a283;
    font-weight: 400;
  }

  .nabz-hero__copy > p:not(.nabz-kicker) {
    max-width: 570px;
    margin: 1.8rem 0 2rem;
    font-size: clamp(15px, 1.25vw, 19px);
    line-height: 1.65;
    color: rgba(239, 230, 216, .82);
  }

  .nabz-thread-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    padding: .4rem 0 .55rem;
    color: var(--nabz-ink);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .15em;
    font-size: 11px;
    font-weight: 750;
  }
