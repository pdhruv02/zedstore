<section class="nabz-chapter nabz-chapter--contact" data-nabz-chapter data-chapter-index="5" id="contact" aria-labelledby="nabz-contact-title">
  <div class="nabz-chapter__frame nabz-contact-frame">
    <div class="nabz-contact-frame__copy">
      <h2 id="nabz-contact-title">wanna promote our product? wanna provide feedback? wanna talk?</h2>
      <p>we are here to respond!</p>
    </div>

    <div class="nabz-contact-frame__form">
      {% form 'contact', id: 'NabzContactForm' %}
        {{ form.errors | default_errors }}

        <div class="nabz-field">
          <label for="NabzContactName">Name</label>
          <input
            id="NabzContactName"
            type="text"
            name="contact[name]"
            value="{{ form.name | escape }}"
            autocomplete="name"
          >
        </div>

        <div class="nabz-field">
          <label for="NabzContactEmail">Email</label>
          <input
            id="NabzContactEmail"
            type="email"
            name="contact[email]"
            value="{{ form.email | escape }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
          >
        </div>

        <div class="nabz-field">
          <label for="NabzContactMessage">Message</label>
          <textarea id="NabzContactMessage" name="contact[body]" rows="7" required>{{ form.body }}</textarea>
        </div>

        <button class="nabz-contact-submit" type="submit">Send</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NABZ contact chapter",
  "settings": [],
  "presets": [
    {
      "name": "NABZ contact chapter"
    }
  ]
}
{% endschema %}
