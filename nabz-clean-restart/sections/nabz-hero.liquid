{{ 'nabz-home.js' | asset_url | script_tag }}
<section class="nabz-chapter nabz-chapter--hero" data-nabz-chapter data-chapter-index="1" id="top" aria-labelledby="nabz-hero-title">
  <div class="nabz-chapter__frame nabz-hero-frame">
    <div class="nabz-hero-frame__media">
      <img
        src="{{ 'nabz-hero-self-contour-hq.webp' | asset_url }}"
        alt="Model wearing the Self-Contour NABZ shirt"
        width="1024"
        height="1536"
        loading="eager"
        fetchpriority="high"
      >
    </div>
    <div class="nabz-hero-frame__shade" aria-hidden="true"></div>
    <div class="nabz-hero-frame__copy">
      <h1 id="nabz-hero-title">Not ethnic wear.<br>Not a plain shirt.<br><em>The space between.</em></h1>
      <p>India’s textile language, re-cut into everyday shirts. Clean from a distance. Unforgettable up close.</p>
    </div>
    <div class="nabz-hero-frame__macro" aria-hidden="true">
      <img
        src="{{ 'nabz-hero-self-contour-macro-hq.webp' | asset_url }}"
        alt=""
        width="302"
        height="779"
        loading="eager"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NABZ hero chapter",
  "settings": [],
  "presets": [
    {
      "name": "NABZ hero chapter"
    }
  ]
}
{% endschema %}
