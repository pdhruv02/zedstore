<section class="nabz-hero nabz-hero--scroll" data-nabz-hero aria-labelledby="nabz-hero-title">
  <div class="nabz-hero__stage">
    <picture class="nabz-hero__media">
      <source media="(max-width: 749px)" srcset="{{ 'nabz-self-contour-hero-mobile-1080.webp' | asset_url }}">
      <img src="{{ 'nabz-self-contour-hero-1920.webp' | asset_url }}" alt="Model wearing a NABZ embroidered shirt" width="1920" height="1081" loading="eager" fetchpriority="high">
    </picture>
    <div class="nabz-hero__shade" aria-hidden="true"></div>
    <div class="nabz-shell nabz-hero__content">
      <div data-nabz-reveal>
        <p class="nabz-kicker">{{ section.settings.kicker }}</p>
        <h1 class="nabz-heading" id="nabz-hero-title">{{ section.settings.line_1 }}<br>{{ section.settings.line_2 }}<br><em>{{ section.settings.line_3 }}</em></h1>
        <p class="nabz-hero__copy">{{ section.settings.copy }}</p>
        <div class="nabz-hero__actions">
          <a class="nabz-button nabz-button--solid" href="#surface">{{ section.settings.primary_label }}</a>
          <a class="nabz-button" href="{{ routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
        </div>
      </div>
    </div>
    <div class="nabz-hero__eyeline" aria-hidden="true">Scroll into the cloth</div>
  </div>
</section>
{% schema %}
{
  "name":"NABZ hero",
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"NABZ"},
    {"type":"text","id":"line_1","label":"Heading line 1","default":"Not ethnic wear."},
    {"type":"text","id":"line_2","label":"Heading line 2","default":"Not a plain shirt."},
    {"type":"text","id":"line_3","label":"Heading line 3","default":"The space between."},
    {"type":"textarea","id":"copy","label":"Copy","default":"India’s textile language, re-cut into everyday shirts. Clean from a distance. Unforgettable up close."},
    {"type":"text","id":"primary_label","label":"Primary button","default":"Enter NABZ"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore shirts"}
  ],
  "presets":[{"name":"NABZ hero"}]
}
{% endschema %}
