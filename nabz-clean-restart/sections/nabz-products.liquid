<section class="nabz-chapter nabz-chapter--products" data-nabz-chapter data-chapter-index="2" id="surface" aria-labelledby="nabz-products-title">
  <div class="nabz-chapter__frame nabz-products-frame">
    <h2 id="nabz-products-title">Unforgettable up close.</h2>

    <div class="nabz-product-gallery" data-nabz-product-gallery>
      {% for block in section.blocks %}
        {% liquid
          assign product_name = block.settings.name | default: 'NABZ'
          assign product_image = block.settings.image
          assign asset_name = block.settings.asset_name
        %}
        <article
          class="nabz-product-panel{% if forloop.first %} is-active{% endif %}"
          data-nabz-product-panel
          data-product-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <button
            class="nabz-product-panel__button"
            type="button"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ product_name | escape }}"
          >
            <span class="nabz-product-panel__media">
              {% if product_image != blank %}
                {{
                  product_image
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    widths: '500, 750, 1000, 1400, 1800',
                    sizes: '(min-width: 990px) 44vw, 84vw',
                    alt: product_name
                }}
              {% elsif asset_name != blank %}
                <img
                  src="{{ asset_name | asset_url }}"
                  alt="{{ product_name | escape }}"
                  width="1024"
                  height="1601"
                  loading="lazy"
                >
              {% endif %}
            </span>
            <span class="nabz-product-panel__name">{{ product_name }}</span>
          </button>
          {% if block.settings.link != blank %}
            <a class="nabz-product-panel__link" href="{{ block.settings.link }}" aria-label="{{ product_name | escape }}">↗</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NABZ eight products",
  "max_blocks": 8,
  "settings": [],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "asset_name",
          "label": "Theme asset fallback"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NABZ eight products",
      "blocks": [
        {"type": "product"},
        {"type": "product"},
        {"type": "product"},
        {"type": "product"},
        {"type": "product"},
        {"type": "product"},
        {"type": "product"},
        {"type": "product"}
      ]
    }
  ]
}
{% endschema %}
