<section class="nabz-chapter nabz-chapter--shoulder" data-nabz-chapter data-chapter-index="4" id="story" aria-labelledby="nabz-shoulder-title">
  <div class="nabz-chapter__frame nabz-shoulder-frame">
    <div class="nabz-shoulder-frame__media">
      <img
        src="{{ 'nabz-hero-air-cable-hq.webp' | asset_url }}"
        alt="Model wearing the Air Cable NABZ shirt"
        width="972"
        height="1619"
        loading="lazy"
      >
    </div>
    <div class="nabz-shoulder-frame__shade" aria-hidden="true"></div>
    <div class="nabz-shoulder-frame__copy">
      <h2 id="nabz-shoulder-title">shirts that feel like suit</h2>
      <p>shoulder fabric extra padded to give square shoulders look.</p>
      <p>say no to dropped or downsloping shoulders</p>
      <svg class="nabz-shoulder-lines" viewBox="0 0 320 96" aria-hidden="true">
        <path d="M18 29 Q83 35 145 65" />
        <path d="M175 55 Q235 24 302 30" />
      </svg>
    </div>
  </div>
</section>

