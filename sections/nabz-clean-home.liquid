{{ 'nabz-clean-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nabz-clean-home.js' | asset_url }}" defer></script>

<div class="nabz-clean-home" data-nabz-home>
  <div class="nabz-selvedge-field" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <section class="nabz-chapter nabz-chapter--identity" id="hero" data-nabz-chapter data-chapter-label="The space between">
    <div class="nabz-chapter__frame nabz-identity">
      <div class="nabz-identity__copy">
        <span class="nabz-folio-mark" aria-hidden="true">N / 01</span>
        <h1>
          <span>Not ethnic wear.</span>
          <span>Not a plain shirt.</span>
          <em>The space between.</em>
        </h1>
      </div>

      <div class="nabz-identity__portrait">
        <img
          src="{{ 'nabz-hero-air-cable.webp' | asset_url }}"
          alt="Air Cable shirt by NABZ"
          width="1584"
          height="1536"
          fetchpriority="high"
        >
        <span class="nabz-identity__wash" aria-hidden="true"></span>
      </div>

      <figure class="nabz-identity__macro">
        <div>
          <img
            src="{{ 'nabz-embroidery-close-up.webp' | asset_url }}"
            alt="Close-up of the Air Cable embroidery and fabric"
            width="476"
            height="496"
            fetchpriority="high"
          >
        </div>
        <figcaption>Thread, seen closer</figcaption>
      </figure>

      <svg class="nabz-identity__thread" viewBox="0 0 720 210" aria-hidden="true">
        <path d="M4 157C124 171 132 39 245 57C365 77 331 183 452 159C559 138 564 27 716 46"></path>
      </svg>
    </div>
  </section>

  <section class="nabz-chapter nabz-chapter--archive" id="products" data-nabz-chapter data-chapter-label="Textile language">
    <div class="nabz-chapter__frame nabz-archive" data-product-archive>
      <div class="nabz-archive__heading">
        <span class="nabz-folio-mark" aria-hidden="true">N / 02</span>
        <h2>
          <span>India’s textile language, re-cut into everyday shirts.</span>
          <em>Clean from a distance. Unforgettable up close.</em>
        </h2>
      </div>

      {% assign product_assets = 'nabz-product-phulkari-pixels.webp|Phulkari Pixels,nabz-product-dissolving-oxford.webp|Dissolving Oxford,nabz-product-moire.webp|Moiré in Motion,nabz-product-jali-air.webp|Jali Air,nabz-product-body-map.webp|Body Map,nabz-product-microcosm.webp|Microcosm,nabz-product-fault-line.webp|Fault Line' | split: ',' %}
      <div class="nabz-archive__stage">
        {% for product_asset in product_assets %}
          {% assign product_parts = product_asset | split: '|' %}
          <figure
            class="nabz-archive-card{% if forloop.first %} is-active{% endif %}"
            data-product-card
            data-product-index="{{ forloop.index0 }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          >
            <div class="nabz-archive-card__image">
              <img
                src="{{ product_parts[0] | asset_url }}"
                alt="{{ product_parts[1] }} embroidered shirt shown from the front, in detail, and from the back"
                width="1003"
                height="1568"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                decoding="async"
              >
            </div>
            <figcaption>
              <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <strong>{{ product_parts[1] }}</strong>
            </figcaption>
          </figure>
        {% endfor %}
      </div>

      <div class="nabz-archive__index" role="group" aria-label="Choose a textile study">
        {% for product_asset in product_assets %}
          {% assign product_parts = product_asset | split: '|' %}
          <button
            class="{% if forloop.first %}is-active{% endif %}"
            type="button"
            data-product-select="{{ forloop.index0 }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <b>{{ product_parts[1] }}</b>
            <i aria-hidden="true"></i>
          </button>
        {% endfor %}
      </div>

      <div class="nabz-archive__controls">
        <button type="button" data-product-previous aria-label="Previous shirt"><span aria-hidden="true">←</span></button>
        <span data-product-count>01 / 07</span>
        <button type="button" data-product-next aria-label="Next shirt"><span aria-hidden="true">→</span></button>
      </div>
    </div>
  </section>

  <section class="nabz-chapter nabz-chapter--fit" id="fit" data-nabz-chapter data-chapter-label="Fit, separated">
    <div class="nabz-chapter__frame nabz-fit-ledger" data-fit-selector>
      <script type="application/json" data-fit-data>
        {
          "S": {"Standard": 26.75, "Extended": null, "width": 78},
          "M": {"Standard": 27, "Extended": 28.5, "width": 88},
          "L": {"Standard": 27.75, "Extended": 29.25, "width": 98},
          "XL": {"Standard": 28.5, "Extended": null, "width": 108}
        }
      </script>

      <div class="nabz-fit-ledger__story" data-fit-story>
        <span class="nabz-folio-mark" aria-hidden="true">N / 03</span>
        <div class="nabz-fit-ledger__story-tabs" role="tablist" aria-label="Fit story">
          <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls="NabzFitProblem" id="NabzFitProblemTab" data-fit-story-tab="problem">The problem</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="NabzFitSystem" id="NabzFitSystemTab" data-fit-story-tab="solution">The system</button>
        </div>
        <div class="nabz-fit-ledger__story-body">
        <article class="nabz-fit-ledger__problem is-active" id="NabzFitProblem" role="tabpanel" aria-labelledby="NabzFitProblemTab" data-fit-story-panel="problem">
          <span class="nabz-kicker">The usual problem</span>
          <h2>Your shirt size shouldn’t decide your shirt length.</h2>
          <p>Your usual size feels tight. You go one size up, it fits better around your body, but now the shirt is too long.</p>
          <p>That extra length can make your body look shorter and throw off the proportion.</p>
        </article>

        <article class="nabz-fit-ledger__solution" id="NabzFitSystem" role="tabpanel" aria-labelledby="NabzFitSystemTab" data-fit-story-panel="solution" hidden>
          <span class="nabz-kicker">The NABZ system</span>
          <h2>NABZ separates size and length.</h2>
          <p>Choose your size for the fit around your body. Then choose the length:</p>
          <div class="nabz-fit-ledger__rules">
            <p><span>Up to 5′8″</span><strong>Standard</strong></p>
            <p><span>Above 5′8″</span><strong>Extended</strong></p>
          </div>
          <p class="nabz-fit-ledger__note">Check the size chart for the exact garment length.</p>
        </article>
        </div>
      </div>

      <div class="nabz-fit-ledger__instrument">
        <div class="nabz-fit-ledger__instrument-head">
          <span class="nabz-kicker">Build your proportion</span>
          <span>Size changes width · Length changes hem</span>
        </div>

        <div class="nabz-proportion-window">
          <span class="nabz-proportion-window__width-label">Body size</span>
          <span class="nabz-proportion-window__length-label">Shirt length</span>
          <div class="nabz-proportion-window__crosshair" aria-hidden="true"></div>
          <div class="nabz-proportion-window__cloth" data-fit-cloth>
            <img src="{{ 'nabz-embroidery-close-up.webp' | asset_url }}" alt="" width="476" height="496">
            <span class="nabz-proportion-window__selvedge" aria-hidden="true"></span>
          </div>
          <output data-fit-output aria-live="polite">M · Standard · 27&quot;</output>
        </div>

        <div class="nabz-fit-ledger__controls">
          <div class="nabz-fit-ledger__control">
            <span>Body size</span>
            <div data-size-buttons aria-label="Size">
              <button type="button" data-size="S" aria-pressed="false">S</button>
              <button class="is-active" type="button" data-size="M" aria-pressed="true">M</button>
              <button type="button" data-size="L" aria-pressed="false">L</button>
              <button type="button" data-size="XL" aria-pressed="false">XL</button>
            </div>
          </div>
          <div class="nabz-fit-ledger__control">
            <span>Shirt length</span>
            <div data-length-buttons aria-label="Length">
              <button class="is-active" type="button" data-length="Standard" aria-pressed="true">Standard</button>
              <button type="button" data-length="Extended" aria-pressed="false" title="Not offered at launch for S and XL">Extended</button>
            </div>
          </div>
        </div>
      </div>

      <div class="nabz-fit-ledger__chart" aria-labelledby="NabzSizeChartTitle">
        <div>
          <span class="nabz-kicker" id="NabzSizeChartTitle">Exact garment length</span>
          <span>Inches</span>
        </div>
        <table>
          <thead><tr><th scope="col">Size</th><th scope="col">Standard</th><th scope="col">Extended</th></tr></thead>
          <tbody data-fit-table-body></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="nabz-chapter nabz-chapter--shoulders" id="shoulders" data-nabz-chapter data-chapter-label="Shoulder structure">
    <div class="nabz-chapter__frame nabz-shoulder-study">
      <div class="nabz-shoulder-study__image">
        <img
          src="{{ 'nabz-shoulder-structure.webp' | asset_url }}"
          alt="NABZ structured shoulder construction on a midnight blue shirt"
          width="1122"
          height="1402"
          loading="lazy"
          decoding="async"
        >
        <span class="nabz-shoulder-study__grain" aria-hidden="true"></span>
        <svg viewBox="0 0 760 250" aria-hidden="true">
          <path d="M22 190C164 170 225 89 349 86C465 82 541 144 736 70"></path>
        </svg>
      </div>

      <div class="nabz-shoulder-study__copy">
        <span class="nabz-folio-mark" aria-hidden="true">N / 04</span>
        <span class="nabz-kicker">Shoulder structure</span>
        <h2>Shirts that feel like a suit at the shoulder.</h2>
        <p>An extra layer of fabric adds subtle structure, creating a cleaner, squarer shoulder line without looking padded.</p>
        <div class="nabz-shoulder-study__proof" aria-label="NABZ shoulder fit principles">
          <span>Square line</span>
          <span>Natural drape</span>
        </div>
        <p class="nabz-shoulder-study__statement">No dropped shoulders.<br>No downward slope.</p>
      </div>
    </div>
  </section>

  <section class="nabz-chapter nabz-chapter--contact" id="contact" data-nabz-chapter data-chapter-label="Talk to NABZ">
    <div class="nabz-chapter__frame nabz-contact-atelier">
      <div class="nabz-contact-atelier__intro">
        <span class="nabz-folio-mark" aria-hidden="true">N / 05</span>
        <div class="nabz-contact-atelier__mark" aria-hidden="true">
          <img src="{{ 'nabz-entry-mark.png' | asset_url }}" alt="" width="706" height="720" loading="lazy">
        </div>
        <h2>The line is open.</h2>
        <p class="nabz-contact-atelier__support">Whatever it is, we’re here to respond.</p>
        <div class="nabz-contact-atelier__topics" aria-label="Ways to contact NABZ">
          <span><b>01</b>Promote NABZ.</span>
          <span><b>02</b>Give feedback.</span>
          <span><b>03</b>Just talk.</span>
        </div>
      </div>

      {% form 'contact', class: 'nabz-contact-atelier__form' %}
        {% if form.posted_successfully? %}<p class="nabz-contact-atelier__status" role="status">Message received. We’ll respond soon.</p>{% endif %}
        {{ form.errors | default_errors }}
        <div class="nabz-contact-atelier__field">
          <label for="NabzContactName">Name</label>
          <input id="NabzContactName" type="text" name="contact[name]" autocomplete="name">
        </div>
        <div class="nabz-contact-atelier__field">
          <label for="NabzContactEmail">Email</label>
          <input id="NabzContactEmail" type="email" name="contact[email]" autocomplete="email" required>
        </div>
        <div class="nabz-contact-atelier__field nabz-contact-atelier__field--message">
          <label for="NabzContactMessage">Message</label>
          <textarea id="NabzContactMessage" name="contact[body]" rows="4" required></textarea>
        </div>
        <button type="submit">Send message <span aria-hidden="true">↗</span></button>
      {% endform %}
    </div>
  </section>

  <div class="nabz-deck-ui" data-deck-ui aria-label="Chapter navigation">
    <span class="nabz-deck-ui__label" data-deck-label>The space between</span>
    <span class="nabz-deck-ui__count" data-deck-count>01 / 05</span>
    <div class="nabz-deck-ui__controls">
      <button type="button" data-deck-previous aria-label="Previous chapter"><span aria-hidden="true">↑</span></button>
      <button type="button" data-deck-next aria-label="Next chapter"><span aria-hidden="true">↓</span></button>
    </div>
  </div>
  <p class="visually-hidden" data-deck-live aria-live="polite"></p>
</div>

{% schema %}
{
  "name": "NABZ quiet selvedge",
  "settings": [],
  "presets": [{ "name": "NABZ quiet selvedge" }]
}
{% endschema %}
