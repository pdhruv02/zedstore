{% liquid
  assign air_product = section.settings.air_product
  assign contour_product = section.settings.contour_product
  assign shop_url = routes.all_products_collection_url
  assign air_url = shop_url
  assign contour_url = shop_url
  if air_product != blank
    assign air_url = air_product.url
  endif
  if contour_product != blank
    assign contour_url = contour_product.url
  endif
%}

<section class="nabz-drop">
  <div class="nabz-drop__visual" data-nabz-reveal>
    <img
      src="{{ 'nabz-embroidered-closing.webp' | asset_url }}"
      alt="{{ 'nabz.drop.logo_alt' | t }}"
      width="1600"
      height="1600"
      loading="lazy"
      decoding="async"
    >
  </div>

  <div class="nabz-drop__content" data-nabz-reveal>
    <p class="nabz-kicker">{{ 'nabz.drop.eyebrow' | t }}</p>
    <h2>{{ 'nabz.drop.headline' | t }}</h2>
    <p class="nabz-drop__names">{{ 'nabz.drop.body' | t }}</p>

    <div class="nabz-drop__products">
      <a href="{{ air_url }}"><span>01</span>{{ 'nabz.drop.air' | t }}<i aria-hidden="true"></i></a>
      <a href="{{ contour_url }}"><span>02</span>{{ 'nabz.drop.contour' | t }}<i aria-hidden="true"></i></a>
    </div>

    <a class="nabz-button nabz-button--light" href="{{ shop_url }}">{{ 'nabz.drop.cta' | t }}</a>
  </div>
</section>

{% stylesheet %}
  .nabz-drop .nabz-kicker,
  .nabz-drop .nabz-button,
  .nabz-drop .nabz-button--light {
    position: relative;
  }

  .nabz-drop {
    display: grid;
    grid-template-columns: minmax(440px, .92fr) minmax(420px, .86fr);
    gap: clamp(72px, 10vw, 170px);
    align-items: center;
    min-height: 100svh;
    padding: clamp(110px, 11vw, 170px) max(32px, calc((100vw - 1480px) / 2));
    color: var(--nabz-cloth);
    background: var(--nabz-ink);
  }

  .nabz-drop__visual {
    position: relative;
    max-width: 720px;
  }

  .nabz-drop__visual::after {
    position: absolute;
    right: -18px;
    bottom: -18px;
    width: 74%;
    height: 74%;
    content: '';
    border-right: 1px solid rgb(177 82 44 / 50%);
    border-bottom: 1px solid rgb(177 82 44 / 50%);
    pointer-events: none;
  }

  .nabz-drop__visual img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }

  .nabz-drop__content {
    max-width: 650px;
  }

  .nabz-drop h2 {
    margin: 0 0 22px;
    color: var(--nabz-cloth);
    font-size: clamp(54px, 6vw, 88px);
    line-height: .95;
  }

  .nabz-drop__names {
    margin: 0;
    color: rgb(238 227 210 / 58%);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .nabz-drop__products {
    display: grid;
    margin: 38px 0 32px;
    border-top: 1px solid rgb(238 227 210 / 18%);
  }

  .nabz-drop__products a {
    display: grid;
    grid-template-columns: 46px 1fr auto;
    align-items: center;
    padding: 17px 0;
    color: var(--nabz-cloth);
    border-bottom: 1px solid rgb(238 227 210 / 18%);
    font-family: var(--nabz-serif);
    font-size: clamp(23px, 2vw, 32px);
    line-height: 1.15;
    text-decoration: none;
  }

  .nabz-drop__products span {
    color: var(--nabz-copper);
    font: 600 9px/1 var(--nabz-sans);
    letter-spacing: .14em;
  }

  .nabz-drop__products i {
    position: relative;
    display: block;
    width: 15px;
    height: 15px;
    color: var(--nabz-copper);
    transition: transform .25s ease;
  }

  .nabz-drop__products i::before {
    position: absolute;
    top: 7px;
    left: 2px;
    width: 11px;
    height: 1px;
    content: '';
    background: currentColor;
    transform: rotate(-45deg);
  }

  .nabz-drop__products i::after {
    position: absolute;
    top: 2px;
    right: 1px;
    width: 6px;
    height: 6px;
    content: '';
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
  }

  .nabz-drop__products a:hover i,
  .nabz-drop__products a:focus-visible i {
    transform: translate(3px, -3px);
  }

  @media (max-width: 989px) {
    .nabz-drop {
      grid-template-columns: 1fr;
    }

    .nabz-drop__visual {
      width: min(82vw, 680px);
    }
  }

  @media (max-width: 749px) {
    .nabz-drop {
      gap: 76px;
      min-height: 0;
      padding: 92px 18px 100px;
    }

    .nabz-drop__visual {
      width: calc(100% - 10px);
    }

    .nabz-drop__visual::after {
      right: -10px;
      bottom: -10px;
    }

    .nabz-drop h2 {
      font-size: clamp(46px, 12.8vw, 60px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:nabz.sections.drop",
  "settings": [
    {
      "type": "product",
      "id": "air_product",
      "label": "t:nabz.settings.air_product"
    },
    {
      "type": "product",
      "id": "contour_product",
      "label": "t:nabz.settings.contour_product"
    }
  ],
  "presets": [
    {
      "name": "t:nabz.sections.drop"
    }
  ]
}
{% endschema %}
