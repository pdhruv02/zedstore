<section class="nabz-fit" id="fit">
  <div class="nabz-fit__stage">
    <figure class="nabz-fit__editorial">
      <img
        src="{{ 'nabz-fit-editorial.webp' | asset_url }}"
        alt="A NABZ shirt showing its controlled shoulder and untucked proportion"
        width="1003"
        height="1568"
        loading="lazy"
        decoding="async"
      >
      <figcaption>
        <span>Fit study / shoulder to hem</span>
        <span>Natural line. Controlled length.</span>
      </figcaption>
    </figure>

    <div class="nabz-fit__content" data-nabz-reveal>
      <p class="nabz-kicker">{{ 'nabz.fit.eyebrow' | t }}</p>
      <h2>{{ 'nabz.fit.headline' | t }}</h2>
      <p class="nabz-fit__lead">{{ 'nabz.fit.body' | t }}</p>

      <div class="nabz-fit__architecture" aria-label="{{ 'nabz.fit.eyebrow' | t }}">
        <div class="nabz-fit__choice">
          <div class="nabz-fit__choice-heading">
            <span>01</span>
            <h3>{{ 'nabz.fit.room' | t }}</h3>
          </div>
          <div class="nabz-fit__options" aria-label="S, M, L">
            <strong>S</strong>
            <strong>M</strong>
            <strong>L</strong>
          </div>
          <p>Choose the shoulder, chest and waist room your body needs.</p>
        </div>

        <div class="nabz-fit__choice">
          <div class="nabz-fit__choice-heading">
            <span>02</span>
            <h3>{{ 'nabz.fit.length' | t }}</h3>
          </div>
          <div class="nabz-fit__options nabz-fit__options--length">
            <strong>{{ 'nabz.fit.standard' | t }}</strong>
            <strong>{{ 'nabz.fit.extended' | t }}</strong>
          </div>
          <p>Keep that same body fit. Change only the length where available.</p>
        </div>
      </div>

      <p class="nabz-fit__availability">{{ 'nabz.fit.unavailable' | t }}</p>
      <p class="nabz-fit__guidance">{{ 'nabz.fit.guidance' | t }}</p>
      <p class="nabz-fit__promise">More room should not automatically mean more length.</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .nabz-fit .nabz-kicker {
    position: relative;
  }

  .nabz-fit {
    padding: clamp(92px, 10vw, 150px) 0;
    color: var(--nabz-cloth);
    background: var(--nabz-ink);
  }

  .nabz-fit__stage {
    display: grid;
    grid-template-columns: minmax(420px, .92fr) minmax(420px, .78fr);
    gap: clamp(64px, 8vw, 132px);
    align-items: center;
    width: var(--nabz-page);
    max-width: 1360px;
    margin-inline: auto;
  }

  .nabz-fit__editorial {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: #d8cdbd;
  }

  .nabz-fit__editorial::after {
    position: absolute;
    inset: 0;
    content: '';
    border: 1px solid rgb(238 227 210 / 18%);
    pointer-events: none;
  }

  .nabz-fit__editorial img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nabz-fit__editorial figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 17px 20px;
    color: var(--nabz-cloth);
    background: rgb(23 18 15 / 84%);
    backdrop-filter: blur(10px);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .nabz-fit__content h2 {
    max-width: 700px;
    margin: 0;
    color: var(--nabz-cloth);
    font-size: clamp(54px, 5.4vw, 82px);
    line-height: .95;
  }

  .nabz-fit__lead {
    max-width: 600px;
    margin: 30px 0 44px;
    color: rgb(238 227 210 / 70%);
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.72;
  }

  .nabz-fit__architecture {
    border-top: 1px solid rgb(238 227 210 / 20%);
  }

  .nabz-fit__choice {
    padding: 28px 0 25px;
    border-bottom: 1px solid rgb(238 227 210 / 20%);
  }

  .nabz-fit__choice-heading {
    display: flex;
    gap: 18px;
    align-items: baseline;
  }

  .nabz-fit__choice-heading span {
    color: var(--nabz-copper);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .nabz-fit__choice-heading h3 {
    margin: 0;
    color: var(--nabz-cloth);
    font-family: var(--nabz-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .nabz-fit__options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 20px 0 14px;
  }

  .nabz-fit__options strong {
    padding: 10px 0;
    color: var(--nabz-cloth);
    border-right: 1px solid rgb(238 227 210 / 18%);
    font-family: var(--nabz-serif);
    font-size: clamp(25px, 2.3vw, 36px);
    font-weight: 400;
    line-height: 1;
    text-align: center;
  }

  .nabz-fit__options strong:first-child {
    text-align: left;
  }

  .nabz-fit__options strong:last-child {
    border-right: 0;
    text-align: right;
  }

  .nabz-fit__options--length {
    grid-template-columns: 1fr 1fr;
  }

  .nabz-fit__options--length strong {
    font-size: clamp(21px, 1.9vw, 30px);
  }

  .nabz-fit__choice > p,
  .nabz-fit__availability,
  .nabz-fit__guidance {
    color: rgb(238 227 210 / 54%);
    font-size: 11px;
    line-height: 1.65;
  }

  .nabz-fit__choice > p {
    margin: 0;
  }

  .nabz-fit__availability {
    margin: 20px 0 0;
    color: rgb(238 227 210 / 72%);
  }

  .nabz-fit__guidance {
    margin: 8px 0 0;
  }

  .nabz-fit__promise {
    max-width: 620px;
    margin: clamp(42px, 5vw, 70px) 0 0;
    color: var(--nabz-cloth);
    font-family: var(--nabz-serif);
    font-size: clamp(30px, 3vw, 46px);
    font-style: italic;
    line-height: 1.05;
  }

  @media (max-width: 989px) {
    .nabz-fit__stage {
      grid-template-columns: minmax(320px, .85fr) 1fr;
      gap: 48px;
    }

    .nabz-fit__content h2 {
      font-size: clamp(48px, 6vw, 64px);
    }
  }

  @media (max-width: 749px) {
    .nabz-fit {
      padding-block: 92px 0;
    }

    .nabz-fit__stage {
      grid-template-columns: 1fr;
      gap: 56px;
      width: 100%;
    }

    .nabz-fit__content {
      grid-row: 1;
      width: var(--nabz-page);
      margin-inline: auto;
    }

    .nabz-fit__editorial {
      grid-row: 2;
      width: 100%;
    }

    .nabz-fit__content h2 {
      font-size: clamp(45px, 12.2vw, 56px);
      line-height: .97;
    }

    .nabz-fit__lead {
      margin-block: 24px 34px;
    }

    .nabz-fit__editorial figcaption {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
      padding-inline: 18px;
    }
  }
{% endstylesheet %}

