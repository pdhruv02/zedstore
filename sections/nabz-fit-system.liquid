<section class="nabz-fit" id="fit">
  <div class="nabz-fit__intro" data-nabz-reveal>
    <div>
      <p class="nabz-kicker">{{ 'nabz.fit.eyebrow' | t }}</p>
      <h2>{{ 'nabz.fit.headline' | t }}</h2>
    </div>
    <div class="nabz-fit__explanation">
      <p>{{ 'nabz.fit.body' | t }}</p>
      <p class="nabz-fit__guidance">{{ 'nabz.fit.guidance' | t }}</p>
    </div>
  </div>

  <div class="nabz-fit__diagram" data-nabz-reveal>
    <img
      src="{{ 'nabz-fit-system.svg' | asset_url }}"
      alt="{{ 'nabz.fit.headline' | t }}"
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
    >
  </div>

  <div class="nabz-fit__mobile-summary" data-nabz-reveal>
    <div>
      <span>01</span>
      <small>{{ 'nabz.fit.room' | t }}</small>
      <strong>S&nbsp;&nbsp; M&nbsp;&nbsp; L</strong>
    </div>
    <div>
      <span>02</span>
      <small>{{ 'nabz.fit.length' | t }}</small>
      <strong>{{ 'nabz.fit.standard' | t }} / {{ 'nabz.fit.extended' | t }}</strong>
    </div>
    <p>{{ 'nabz.fit.unavailable' | t }}</p>
  </div>
</section>

{% stylesheet %}
  .nabz-fit .nabz-kicker {
    position: relative;
  }

  .nabz-fit {
    padding: clamp(110px, 11vw, 170px) 0;
    color: var(--nabz-cloth);
    background: var(--nabz-ink);
  }

  .nabz-fit__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(330px, .7fr);
    gap: clamp(54px, 10vw, 170px);
    align-items: end;
    width: var(--nabz-page);
    margin: 0 auto clamp(52px, 6vw, 84px);
  }

  .nabz-fit h2 {
    max-width: 820px;
    margin: 0;
    color: var(--nabz-cloth);
    font-size: clamp(50px, 5.8vw, 86px);
    line-height: .96;
  }

  .nabz-fit__explanation > p:first-child {
    margin: 0;
    color: rgb(238 227 210 / 76%);
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.7;
  }

  .nabz-fit__guidance {
    margin: 24px 0 0;
    padding-top: 22px;
    color: rgb(238 227 210 / 53%);
    border-top: 1px solid rgb(238 227 210 / 15%);
    font-size: 12px;
    line-height: 1.65;
  }

  .nabz-fit__diagram {
    width: min(100% - 64px, 1320px);
    margin-inline: auto;
  }

  .nabz-fit__diagram img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nabz-fit__mobile-summary {
    display: none;
  }

  @media (max-width: 749px) {
    .nabz-fit {
      padding-block: 92px;
    }

    .nabz-fit__intro {
      grid-template-columns: 1fr;
      gap: 34px;
      margin-bottom: 44px;
    }

    .nabz-fit h2 {
      font-size: clamp(44px, 12.5vw, 56px);
      line-height: .98;
    }

    .nabz-fit__diagram {
      width: calc(100% - 20px);
      overflow: hidden;
    }

    .nabz-fit__diagram img {
      width: 116%;
      max-width: none;
      margin-left: -8%;
    }

    .nabz-fit__mobile-summary {
      display: grid;
      width: var(--nabz-page);
      margin: 34px auto 0;
      border-top: 1px solid rgb(238 227 210 / 18%);
    }

    .nabz-fit__mobile-summary > div {
      display: grid;
      grid-template-columns: 36px 1fr auto;
      align-items: center;
      gap: 12px;
      padding: 18px 0;
      border-bottom: 1px solid rgb(238 227 210 / 18%);
    }

    .nabz-fit__mobile-summary span,
    .nabz-fit__mobile-summary small {
      color: rgb(238 227 210 / 52%);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .nabz-fit__mobile-summary strong {
      color: var(--nabz-cloth);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .nabz-fit__mobile-summary > p {
      margin: 16px 0 0 48px;
      color: rgb(238 227 210 / 50%);
      font-size: 11px;
      line-height: 1.55;
    }
  }
{% endstylesheet %}

