<div class="nabz-announcement{% unless section.settings.show_announcement %} nabz-announcement--hidden{% endunless %}">
  <span>{{ 'nabz.nav.announcement' | t }}</span>
</div>

<header class="nabz-header" data-nabz-header>
  <div class="nabz-header__inner">
    <details class="nabz-mobile-menu">
      <summary aria-label="{{ 'nabz.nav.menu' | t }}">
        <span></span>
        <span></span>
      </summary>
      <div class="nabz-mobile-menu__panel">
        <nav aria-label="{{ 'accessibility.menu' | t }}">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endfor %}
        </nav>
      </div>
    </details>

    <a class="nabz-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <svg viewBox="0 0 360 92" aria-hidden="true" focusable="false">
        <text x="4" y="76">N</text>
        <text x="224" y="76">B</text>
        <text x="294" y="76">Z</text>
        <path d="M48 54H108L128 35 155 77 185 8 217 54H246"/>
      </svg>
    </a>

    <nav class="nabz-desktop-nav" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endfor %}
    </nav>

    <div class="nabz-header__actions">
      <a href="{{ routes.search_url }}" aria-label="{{ 'nabz.nav.search' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" aria-label="{{ 'nabz.nav.cart_count' | t: count: cart.item_count }}">
        <span>{{ 'nabz.nav.cart' | t }}</span>
        <sup>{{ cart.item_count }}</sup>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  :root {
    --nabz-ink: #17120f;
    --nabz-ink-soft: #2a211c;
    --nabz-cloth: #eee3d2;
    --nabz-paper: #f7f1e7;
    --nabz-copper: #b1522c;
    --nabz-olive: #52523d;
    --nabz-line: rgb(23 18 15 / 18%);
    --nabz-serif: 'Iowan Old Style', 'Baskerville', 'Times New Roman', serif;
    --nabz-sans: Arial, Helvetica, sans-serif;
  }

  html {
    scroll-behavior: smooth;
    background: var(--nabz-ink);
  }

  body {
    color: var(--nabz-ink);
    background: var(--nabz-paper);
    font-family: var(--nabz-sans);
    -webkit-font-smoothing: antialiased;
  }

  body,
  button,
  input,
  select,
  textarea {
    font-family: var(--nabz-sans);
  }

  h1,
  h2,
  h3,
  h4,
  .h1,
  .h2,
  .h3,
  .h4 {
    font-family: var(--nabz-serif);
    font-weight: 400;
    letter-spacing: -.035em;
  }

  a {
    text-underline-offset: .22em;
  }

  .nabz-announcement {
    position: relative;
    z-index: 52;
    display: grid;
    place-items: center;
    min-height: 29px;
    padding: 6px 20px;
    color: var(--nabz-cloth);
    background: var(--nabz-copper);
    font: 600 10px/1.2 var(--nabz-sans);
    letter-spacing: .18em;
    text-align: center;
    text-transform: uppercase;
  }

  .nabz-announcement--hidden {
    display: none;
  }

  .nabz-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--nabz-cloth);
    background: rgb(23 18 15 / 88%);
    border-bottom: 1px solid rgb(238 227 210 / 14%);
    backdrop-filter: blur(18px) saturate(130%);
    transition: background-color .35s ease, box-shadow .35s ease;
  }

  .nabz-header.is-scrolled {
    background: rgb(23 18 15 / 97%);
    box-shadow: 0 14px 40px rgb(0 0 0 / 12%);
  }

  .nabz-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    width: min(100% - 40px, 1480px);
    min-height: 70px;
    margin-inline: auto;
  }

  .nabz-wordmark {
    display: block;
    width: 122px;
    color: var(--nabz-cloth);
  }

  .nabz-wordmark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .nabz-wordmark text {
    fill: currentColor;
    font-family: var(--nabz-serif);
    font-size: 82px;
    font-weight: 400;
  }

  .nabz-wordmark path {
    fill: none;
    stroke: var(--nabz-copper);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nabz-desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(24px, 3vw, 52px);
  }

  .nabz-desktop-nav a,
  .nabz-header__actions a {
    color: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nabz-desktop-nav a {
    position: relative;
    padding-block: 24px;
  }

  .nabz-desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 18px;
    left: 0;
    height: 1px;
    content: '';
    background: var(--nabz-copper);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .35s ease;
  }

  .nabz-desktop-nav a:hover::after,
  .nabz-desktop-nav a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nabz-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 22px;
  }

  .nabz-header__actions a {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .nabz-header__actions svg {
    width: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .nabz-header__actions sup {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    color: var(--nabz-cloth);
    background: var(--nabz-copper);
    border-radius: 50%;
    font-size: 9px;
    line-height: 1;
  }

  .nabz-mobile-menu {
    display: none;
  }

  .nabz-kicker {
    margin: 0 0 20px;
    color: var(--nabz-copper);
    font: 700 10px/1.2 var(--nabz-sans);
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .nabz-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 14px 24px;
    overflow: hidden;
    color: var(--nabz-cloth);
    background: var(--nabz-ink);
    border: 1px solid var(--nabz-ink);
    border-radius: 0;
    font: 700 10px/1 var(--nabz-sans);
    letter-spacing: .18em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color .3s ease, background-color .3s ease, border-color .3s ease;
  }

  .nabz-button:hover,
  .nabz-button:focus-visible {
    color: var(--nabz-cloth);
    background: var(--nabz-copper);
    border-color: var(--nabz-copper);
  }

  .nabz-button--light {
    color: var(--nabz-ink);
    background: var(--nabz-cloth);
    border-color: var(--nabz-cloth);
  }

  [data-nabz-reveal] {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1);
  }

  [data-nabz-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  main[data-template*='product'],
  main[data-template*='collection'],
  main[data-template*='cart'],
  main[data-template*='page'],
  main[data-template*='search'] {
    background: var(--nabz-paper);
  }

  main[data-template*='product'] h1,
  main[data-template*='collection'] h1,
  main[data-template*='cart'] h1,
  main[data-template*='page'] h1,
  main[data-template*='search'] h1 {
    font-family: var(--nabz-serif) !important;
    font-size: clamp(2.5rem, 5vw, 5.5rem) !important;
    font-weight: 400 !important;
    letter-spacing: -.045em !important;
    line-height: .95 !important;
  }

  main[data-template*='product'] .button,
  main[data-template*='product'] button[type='submit'],
  main[data-template*='cart'] button[type='submit'] {
    min-height: 52px;
    border-radius: 0 !important;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  main[data-template*='product'] .product-information,
  main[data-template*='collection'] .collection,
  main[data-template*='cart'] .cart-page {
    --page-width: 1480px;
  }

  .product-card,
  .collection-card {
    border-radius: 0 !important;
  }

  .product-card img,
  main[data-template*='product'] img {
    border-radius: 0 !important;
  }

  @media (max-width: 749px) {
    .nabz-header__inner {
      grid-template-columns: 42px 1fr auto;
      width: calc(100% - 28px);
      min-height: 62px;
    }

    .nabz-wordmark {
      justify-self: center;
      width: 106px;
    }

    .nabz-desktop-nav,
    .nabz-header__actions > a:first-child,
    .nabz-header__actions a > span {
      display: none;
    }

    .nabz-mobile-menu {
      display: block;
    }

    .nabz-mobile-menu summary {
      display: grid;
      gap: 6px;
      width: 36px;
      padding: 12px 0;
      cursor: pointer;
      list-style: none;
    }

    .nabz-mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .nabz-mobile-menu summary span {
      display: block;
      width: 23px;
      height: 1px;
      background: currentColor;
      transition: transform .3s ease;
    }

    .nabz-mobile-menu[open] summary span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .nabz-mobile-menu[open] summary span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    .nabz-mobile-menu__panel {
      position: fixed;
      top: 91px;
      right: 0;
      bottom: 0;
      left: 0;
      padding: 48px 28px;
      color: var(--nabz-cloth);
      background: var(--nabz-ink);
      border-top: 1px solid rgb(238 227 210 / 12%);
    }

    .nabz-announcement--hidden + .nabz-header .nabz-mobile-menu__panel {
      top: 62px;
    }

    .nabz-mobile-menu nav {
      display: grid;
    }

    .nabz-mobile-menu nav a {
      padding: 18px 0;
      color: inherit;
      border-bottom: 1px solid rgb(238 227 210 / 16%);
      font-family: var(--nabz-serif);
      font-size: 38px;
      letter-spacing: -.03em;
      text-decoration: none;
    }

    [data-nabz-reveal] {
      transform: translateY(20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
    }

    [data-nabz-reveal] {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const nabzHeader = document.querySelector('[data-nabz-header]');

  if (nabzHeader) {
    const updateHeader = () => nabzHeader.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }

  document.querySelectorAll('.nabz-mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('[data-nabz-reveal]').forEach((element) => revealObserver.observe(element));
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:nabz.sections.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:nabz.settings.menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "t:nabz.settings.show_announcement",
      "default": true
    }
  ]
}
{% endschema %}
