{{ 'nabz-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nabz-home.js' | asset_url }}" defer></script>
<section class="nabz-chapter nabz-chapter--fit" data-nabz-chapter data-chapter-index="3">
  <div class="nabz-chapter__frame nabz-fit-frame">
    <div class="nabz-fit-copy">
      <h2>S or M size is too narrow and tight for you? and the next size is comfortably loose but becomes unnecessarily long?</h2>
      <p class="nabz-fit-read">read this one...</p>
      <p>Shirts longer than your torso makes you appear shorter, and ruins the overall proportion.</p>
      <h3>NABZ separates size and length</h3>
      <p>Up to 5′8″? Start with Standard. Above 5′8″? Start with Extended. Refer to the size chart for precise fit.</p>
    </div>
    <div class="nabz-fit-tool" data-fit-tool>
      <div class="nabz-fit-controls">
        <div class="nabz-fit-buttons"><button type="button" data-size="S" aria-pressed="false">S</button><button class="is-active" type="button" data-size="M" aria-pressed="true">M</button><button type="button" data-size="L" aria-pressed="false">L</button><button type="button" data-size="XL" aria-pressed="false">XL</button></div>
        <div class="nabz-fit-buttons"><button class="is-active" type="button" data-length="Standard" aria-pressed="true">Standard</button><button type="button" data-length="Extended" aria-pressed="false">Extended</button></div>
      </div>
      <div class="nabz-fit-visual" aria-hidden="true"><svg class="nabz-fit-shirt" viewBox="0 0 220 280"><path class="shirt-body" data-shirt-body d="M72 62 L48 78 L24 130 L48 148 L62 112 L69 126 L69 230 Q110 240 151 230 L151 126 L158 112 L172 148 L196 130 L172 78 L148 62 L132 82 L88 82 Z"/><path class="shirt-detail" d="M88 82 Q110 100 132 82 M110 100 L110 220 M91 82 L101 62 L119 62 L129 82"/><line class="measure" data-measure x1="202" y1="62" x2="202" y2="230"/><line class="measure-tick" x1="196" y1="62" x2="208" y2="62"/><line class="measure-tick" data-measure-tick x1="196" y1="230" x2="208" y2="230"/></svg></div>
      <output class="nabz-fit-output" data-fit-output aria-live="polite">M · Standard · 27&quot;</output>
      <div class="nabz-size-table-wrap"><table class="nabz-size-table"><thead><tr><th>Size</th><th>Standard</th><th>Extended</th></tr></thead><tbody><tr data-row="S"><th>S</th><td data-cell="S-Standard">26.75&quot;</td><td data-cell="S-Extended">Not initially offered</td></tr><tr class="is-active" data-row="M"><th>M</th><td class="is-active" data-cell="M-Standard">27&quot;</td><td data-cell="M-Extended">28.5&quot;</td></tr><tr data-row="L"><th>L</th><td data-cell="L-Standard">27.75&quot;</td><td data-cell="L-Extended">29.25&quot;</td></tr><tr data-row="XL"><th>XL</th><td data-cell="XL-Standard">28.5&quot;</td><td data-cell="XL-Extended">Not initially offered</td></tr></tbody></table></div>
    </div>
  </div>
</section>
{% schema %}{"name":"NABZ fit","settings":[],"presets":[{"name":"NABZ fit"}]}{% endschema %}