{{ 'nabz-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nabz-home.js' | asset_url }}" defer></script>
<section class="nabz-chapter nabz-chapter--products" data-nabz-chapter data-chapter-index="2">
  <div class="nabz-chapter__frame nabz-products-frame">
    <h2>Unforgettable up close.</h2>
    <div class="nabz-product-gallery" data-product-gallery>
      {% for block in section.blocks %}
        {% liquid
          case forloop.index
            when 1
              assign fallback_name = 'nabz-product-fault-line-final.webp'
            when 2
              assign fallback_name = 'nabz-product-jali-air-final.webp'
            when 3
              assign fallback_name = 'nabz-product-microcosm-final.webp'
            when 4
              assign fallback_name = 'nabz-product-phulkari-pixels-final.webp'
            when 5
              assign fallback_name = 'nabz-product-dissolving-oxford-final.webp'
            when 6
              assign fallback_name = 'nabz-product-shadow-study-final.webp'
            when 7
              assign fallback_name = 'nabz-product-moire-in-motion-final.webp'
            when 8
              assign fallback_name = 'nabz-product-body-map-final.webp'
          endcase
        %}
        <button class="nabz-product-panel{% if forloop.first %} is-active{% endif %}" type="button" data-product-panel aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
          <img src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1800 }}{% else %}{{ fallback_name | asset_url }}{% endif %}" alt="{{ block.settings.name | escape }}" width="1003" height="1568" loading="{% if forloop.index < 3 %}eager{% else %}lazy{% endif %}">
          <span class="nabz-product-panel__name">{{ block.settings.name }}</span>
        </button>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"NABZ eight products","max_blocks":8,"blocks":[{"type":"product","name":"Product","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"name","label":"Product name"},{"type":"url","id":"link","label":"Product link"}]}],"presets":[{"name":"NABZ eight products"}]}
{% endschema %}