{{ 'nabz-base.css' | asset_url | stylesheet_tag }}
<div class="nabz-home-marker" hidden aria-hidden="true"></div>
{% unless request.design_mode %}
  <div class="nabz-entry" data-nabz-entry aria-hidden="true">
    <span class="nabz-entry__cut"></span>
    <div class="nabz-entry__mark">
      <img src="{{ 'nabz-entry-mark.png' | asset_url }}" alt="" width="706" height="720" fetchpriority="high">
    </div>
  </div>
{% endunless %}
<header class="nabz-site-header" data-nabz-header>
  <div class="nabz-site-header__bar">
    <a class="nabz-site-header__brand" href="{{ routes.root_url }}" aria-label="NABZ home">
      <img src="{{ 'nabz-wordmark.png' | asset_url }}" alt="NABZ" width="396" height="180" fetchpriority="high">
    </a>
    <nav class="nabz-site-header__nav" aria-label="Primary navigation">
      <a href="#products">Surface</a>
      <a href="#fit">Fit</a>
      <a href="#shoulders">Shoulders</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="nabz-site-header__bag" href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a>
  </div>
</header>
{% schema %}
{"name":"NABZ header","settings":[],"presets":[{"name":"NABZ header"}]}
{% endschema %}
