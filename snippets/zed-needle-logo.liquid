{%- liquid
  assign logo_class = class | default: ''
  assign show_wordmark_value = true
  if show_wordmark == false
    assign show_wordmark_value = false
  endif
-%}
<span class="zed-needle-logo {{ logo_class }}" aria-label="ZED">
  <svg class="zed-needle-logo__mark" viewBox="0 0 180 118" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="zed-thread-gradient-{{ section.id | default: 'global' }}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#d47a4c" />
        <stop offset="0.48" stop-color="#a94d2a" />
        <stop offset="1" stop-color="#e0a36f" />
      </linearGradient>
      <filter id="zed-thread-shadow-{{ section.id | default: 'global' }}" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000" flood-opacity=".55" />
      </filter>
    </defs>
    <path class="zed-needle-logo__thread" pathLength="1" d="M22 26 C22 16 31 12 43 12 H137 C147 12 151 17 146 25 L38 92 C31 97 34 105 45 105 H131" fill="none" stroke="url(#zed-thread-gradient-{{ section.id | default: 'global' }})" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" filter="url(#zed-thread-shadow-{{ section.id | default: 'global' }})" />
    <path class="zed-needle-logo__stitch" pathLength="1" d="M22 26 C22 16 31 12 43 12 H137 C147 12 151 17 146 25 L38 92 C31 97 34 105 45 105 H131" fill="none" stroke="rgba(255,255,255,.34)" stroke-width="1.4" stroke-dasharray=".008 .015" stroke-linecap="round" />
    <g class="zed-needle-logo__needle" transform="translate(129 95) rotate(-16)">
      <path d="M0 8 L34 0 L4 14 Z" fill="#d9d2c6" />
      <path d="M23 4 L31 2 L25 7 Z" fill="#171513" />
    </g>
  </svg>
  {%- if show_wordmark_value -%}<span class="zed-needle-logo__word">ZED</span>{%- endif -%}
</span>