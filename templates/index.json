{
  "sections": {
    "zed_experience": {
      "type": "zed-experience",
      "settings": {
        "primary_link": "shopify://collections/all"
      }
    },
    "product_list": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "Products",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "gap": 12,
            "width": "fill"
          },
          "blocks": {
            "heading": {
              "type": "_product-list-text",
              "name": "Collection title",
              "settings": {
                "text": "<h3>Shop ZED</h3>",
                "width": "fit-content",
                "alignment": "left",
                "type_preset": "h4"
              },
              "blocks": {}
            },
            "button": {
              "type": "_product-list-button",
              "name": "View all",
              "settings": {
                "label": "View all",
                "style_class": "button-unstyled",
                "width": "fit-content"
              },
              "blocks": {}
            }
          },
          "block_order": ["heading", "button"]
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "Product card",
          "static": true,
          "settings": {"product_card_gap": 4, "border": "none"},
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "name": "Product media",
              "settings": {"image_ratio": "adapt", "border": "none"},
              "blocks": {}
            },
            "title": {
              "type": "product-title",
              "name": "Product title",
              "settings": {"width": "100%", "alignment": "left", "type_preset": "paragraph", "padding-block-start": 4},
              "blocks": {}
            },
            "price": {
              "type": "price",
              "name": "Price",
              "settings": {"show_sale_price_first": true, "type_preset": "h6", "width": "100%", "alignment": "left"},
              "blocks": {}
            }
          },
          "block_order": ["gallery", "title", "price"]
        }
      },
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "1",
        "columns_gap": 8,
        "rows_gap": 24,
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 28,
        "padding-block-start": 64,
        "padding-block-end": 80
      }
    }
  },
  "order": ["zed_experience", "product_list"]
}
